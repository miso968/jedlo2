# Copy this file to .env and fill in your actual database credentials.
# NEVER commit the real .env file — it's already in .gitignore.

PORT=3000

# MySQL connection (e.g. your phpMyAdmin-managed hosting database)
DB_HOST=db001.nameserver.sk
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=webtestsql

# Folder (inside /public) where uploaded recipe images are stored
UPLOAD_DIR=./public/uploads

# Admin login (protects /admin.html and /api/admin/*)
ADMIN_PASSWORD=choose_a_strong_password_here

# Long random string used to sign session cookies — generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string
